# コピーして .env にする
ANTHROPIC_API_KEY=sk-ant-...
# 現代語訳に使うモデル（既定: claude-opus-5-5）
KOBUN_MODEL=claude-opus-5-5
# 思考の深さ low/medium/high/xhigh/max（既定: high）
KOBUN_EFFORT=high
# OCRデバイス cpu / cuda（cuda は onnxruntime-gpu 導入時のみ）
KOBUN_DEVICE=cpu
# NDL-Lite の src の場所を変える場合
# NDL_LITE_SRC=C:/dev/ndlkotenocr-lite/src
